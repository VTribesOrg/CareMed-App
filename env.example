FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key

DATABASE_URL=mysql+pymysql://username:password@localhost:3307/caremeddb

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-app-password

# Accounts allowed into the Developer console (branches management).
# Comma-separated; each address is promoted to the Developer role on Google sign-in.
DEVELOPER_EMAILS=your-developer-email@gmail.com